<p>Hello <%= @invitation.name %>,</p>

<p>
  <% if @invitation.inviter_name %>
    <%= @invitation.inviter_name %> invited you to administer <%= @invitation.school_name %> as <%= @invitation.role == "admin" ? "an admin" : "an assistant admin" %>.
  <% else %>
    You are invited to administer <%= @invitation.school_name %> as <%= @invitation.role == "admin" ? "an admin" : "an assistant admin" %>.
  <% end %>
</p>

<p><a href="<%= @link %>">Accept the invitation</a></p>

<p>The link works until <%= @invitation.expires_at.to_fs(:long) %> UTC. If you did not expect this email, you can ignore it.</p>
